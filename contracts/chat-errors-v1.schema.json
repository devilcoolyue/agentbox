{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.local/contracts/chat-errors-v1.schema.json",
  "title": "Agentbox additive errors and durable chat v1",
  "$defs": {
    "ChatRequestInput": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "thread_id": {
          "type": "string",
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "maxLength": 1048576,
          "description": "Server also limits UTF-8 bytes to 1 MiB."
        },
        "model": {
          "type": "string",
          "maxLength": 512
        },
        "effort": {
          "type": "string",
          "maxLength": 512
        },
        "effort_control": {
          "type": "string",
          "maxLength": 512
        },
        "attachments": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^/shared/\\.(images|file)/[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
          }
        },
        "delegation": {
          "$ref": "#/$defs/DelegationOptions",
          "description": "Lets the main agent hand subtasks to these worker models during this turn; absent keeps an ordinary chat."
        },
        "suggestions": {
          "type": "boolean",
          "description": "Asks for a predicted next prompt after the turn, an extra charged request; only sent when /me reports prompt_suggestions."
        },
        "questions": {
          "type": "boolean",
          "description": "The sending page can show the agent's questions and answer them during the turn; only sent when /me reports chat_questions."
        },
        "delivery": {
          "type": "string",
          "enum": ["queue", "steer"],
          "description": "A follow-up sent while a turn runs: queue runs it as the next turn; steer hands it to the running turn when it takes more input, else queues it. Absent is an ordinary send, refused while busy; only sent when /me reports chat_followups."
        }
      },
      "required": [
        "scope",
        "thread_id",
        "text",
        "model",
        "effort",
        "effort_control"
      ],
      "additionalProperties": false
    },
    "DelegationOptions": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "workers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/DelegationWorker"
          }
        },
        "jev": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "workers",
        "jev"
      ],
      "additionalProperties": false
    },
    "DelegationWorker": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "account_id",
        "model"
      ],
      "additionalProperties": false
    },
    "ChatRequestReceipt": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "session_id": {
          "type": "string",
          "maxLength": 128
        },
        "thread_id": {
          "type": "string",
          "maxLength": 128
        },
        "turn_id": {
          "type": "string",
          "maxLength": 128
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatRequestInput"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "accepted",
            "starting",
            "running",
            "completed",
            "failed",
            "interrupted",
            "uncertain",
            "reviewed",
            "abandoned",
            "deleted"
          ]
        },
        "error_code": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "merged_into": {
          "type": "string",
          "description": "The running request a steered follow-up was handed to; it never runs a turn itself."
        }
      },
      "required": [
        "request_id",
        "session_id",
        "thread_id",
        "turn_id",
        "request",
        "state",
        "revision",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": true
    },
    "ChatRequestResponse": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "receipt": {
          "$ref": "#/$defs/ChatRequestReceipt"
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "receipt"
      ],
      "additionalProperties": true
    },
    "ChatRequestList": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "scope": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requests": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/ChatRequestReceipt"
          }
        },
        "pending": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatRequestReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "scope",
        "requests",
        "pending"
      ],
      "additionalProperties": true
    },
    "ChatRequestEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "chat_request"
        },
        "version": {
          "const": 1
        },
        "receipt": {
          "$ref": "#/$defs/ChatRequestReceipt"
        }
      },
      "required": [
        "type",
        "version",
        "receipt"
      ],
      "additionalProperties": true
    },
    "APIProblem": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "hint": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": true
    }
  }
}
