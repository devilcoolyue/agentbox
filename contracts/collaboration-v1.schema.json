{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.local/contracts/collaboration-v1.schema.json",
  "title": "Agentbox collaboration v1 handoffs and task API",
  "description": "Versioned role, handoff and task HTTP contracts. The server additionally enforces byte limits, ownership, scope, revisions, workflow and reference validity.",
  "$ref": "#/$defs/CollaborationHandoff",
  "$defs": {
    "CollaborationRole": {
      "enum": [
        "coordinator",
        "executor"
      ]
    },
    "CollaborationBinding": {
      "type": "object",
      "properties": {
        "agent_type": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "account_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 68
        },
        "effort": {
          "type": "string",
          "maxLength": 16
        },
        "effort_control": {
          "enum": [
            "",
            "effort",
            "budget"
          ]
        }
      },
      "required": [
        "agent_type",
        "account_id",
        "model",
        "effort",
        "effort_control"
      ],
      "additionalProperties": false
    },
    "CollaborationRoles": {
      "type": "object",
      "properties": {
        "coordinator": {
          "$ref": "#/$defs/CollaborationBinding"
        },
        "executor": {
          "$ref": "#/$defs/CollaborationBinding"
        }
      },
      "required": [
        "coordinator",
        "executor"
      ],
      "additionalProperties": false
    },
    "CollaborationPlanItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "maxItems": 16,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "text",
        "acceptance"
      ],
      "additionalProperties": false
    },
    "CollaborationPlan": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CollaborationPlanItem"
          },
          "maxItems": 32,
          "minItems": 1
        },
        "constraints": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "maxItems": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "code_map": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CollaborationCodeMapEntry"
              },
              "maxItems": 32
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "summary",
        "items"
      ],
      "additionalProperties": false
    },
    "CollaborationQuestion": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "options": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "maxItems": 8
            },
            {
              "type": "null"
            }
          ]
        },
        "blocking": {
          "const": true
        },
        "context_refs": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              "maxItems": 32
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "text",
        "blocking"
      ],
      "additionalProperties": false
    },
    "CollaborationAnswer": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "question_id",
        "text"
      ],
      "additionalProperties": false
    },
    "CollaborationResult": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "completed": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "maxItems": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "remaining": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "maxItems": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "tests": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "maxItems": 32
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    },
    "CollaborationReview": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "approve",
            "revise",
            "needs_user"
          ]
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "plan_version": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "changes": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "maxItems": 32
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decision",
        "snapshot_id",
        "plan_version",
        "summary"
      ],
      "additionalProperties": false
    },
    "CollaborationPlanHandoff": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "plan"
        },
        "payload": {
          "$ref": "#/$defs/CollaborationPlan"
        }
      },
      "required": [
        "version",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "CollaborationQuestionHandoff": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "question"
        },
        "payload": {
          "$ref": "#/$defs/CollaborationQuestion"
        }
      },
      "required": [
        "version",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "CollaborationAnswerHandoff": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "answer"
        },
        "payload": {
          "$ref": "#/$defs/CollaborationAnswer"
        }
      },
      "required": [
        "version",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "CollaborationResultHandoff": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "result"
        },
        "payload": {
          "$ref": "#/$defs/CollaborationResult"
        }
      },
      "required": [
        "version",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "CollaborationReviewHandoff": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "review"
        },
        "payload": {
          "$ref": "#/$defs/CollaborationReview"
        }
      },
      "required": [
        "version",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "CollaborationHandoff": {
      "anyOf": [
        {
          "$ref": "#/$defs/CollaborationPlanHandoff"
        },
        {
          "$ref": "#/$defs/CollaborationQuestionHandoff"
        },
        {
          "$ref": "#/$defs/CollaborationAnswerHandoff"
        },
        {
          "$ref": "#/$defs/CollaborationResultHandoff"
        },
        {
          "$ref": "#/$defs/CollaborationReviewHandoff"
        }
      ]
    },
    "CollaborationConfiguration": {
      "type": "object",
      "properties": {
        "roles": {
          "$ref": "#/$defs/CollaborationRoles"
        },
        "auto_execute": {
          "type": "boolean"
        },
        "max_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "budget_micro_usd": {
          "type": "integer",
          "minimum": 0
        },
        "verification_command": {
          "type": "string",
          "maxLength": 8192
        },
        "step_timeout_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800
        },
        "total_runtime_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "wait_timeout_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2592000
        },
        "workflow": {
          "$ref": "#/$defs/CollaborationWorkflow"
        }
      },
      "required": [
        "roles",
        "auto_execute",
        "max_repairs",
        "max_steps",
        "budget_micro_usd"
      ],
      "additionalProperties": false
    },
    "CollaborationCreateInput": {
      "type": "object",
      "properties": {
        "roles": {
          "$ref": "#/$defs/CollaborationRoles"
        },
        "auto_execute": {
          "type": "boolean"
        },
        "max_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "budget_micro_usd": {
          "type": "integer",
          "minimum": 0
        },
        "verification_command": {
          "type": "string",
          "maxLength": 8192
        },
        "step_timeout_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800
        },
        "total_runtime_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "wait_timeout_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2592000
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_session_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "context": {
          "$ref": "#/$defs/CollaborationThreadContext"
        },
        "decision": {
          "$ref": "#/$defs/CollaborationDecisionIntent"
        },
        "workflow": {
          "$ref": "#/$defs/CollaborationWorkflow"
        }
      },
      "required": [
        "scope",
        "source_session_id",
        "text",
        "repository",
        "baseline",
        "roles",
        "auto_execute",
        "max_repairs",
        "max_steps",
        "budget_micro_usd"
      ],
      "additionalProperties": false
    },
    "CollaborationActionInput": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": [
            "pause",
            "resume",
            "configure",
            "review",
            "answer",
            "cancel",
            "confirm_plan",
            "repair_handoff",
            "supplement"
          ]
        },
        "payload": {}
      },
      "required": [
        "scope",
        "expected_revision",
        "action"
      ],
      "additionalProperties": false
    },
    "CollaborationDeleteInput": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "scope",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "CollaborationVerification": {
      "type": "object",
      "properties": {
        "helper_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "snapshot_id": {
          "type": "string"
        },
        "config_version": {
          "type": "integer",
          "minimum": 1
        },
        "command": {
          "type": "string"
        },
        "state": {
          "enum": [
            "running",
            "completed",
            "failed",
            "uncertain",
            "not_requested"
          ]
        },
        "output": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_truncated": {
          "type": "boolean"
        },
        "argv": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "helper_id",
        "run_id",
        "snapshot_id",
        "config_version",
        "command",
        "state",
        "output",
        "duration_ms",
        "exit_code",
        "output_truncated",
        "argv"
      ],
      "additionalProperties": false
    },
    "CollaborationEvent": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string"
        },
        "body": {},
        "created_at": {
          "type": "string"
        }
      },
      "required": [
        "seq",
        "type",
        "body",
        "created_at"
      ],
      "additionalProperties": false
    },
    "CollaborationThreadContext": {
      "type": "object",
      "properties": {
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "integer",
          "minimum": 0
        },
        "include": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "text": {
          "type": "string",
          "maxLength": 24000
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "thread_id",
        "anchor",
        "include",
        "sha256",
        "text",
        "truncated"
      ],
      "additionalProperties": false
    },
    "CollaborationDecisionRoleIntent": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "fixed",
            "auto"
          ]
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "CollaborationDecisionRolesIntent": {
      "type": "object",
      "properties": {
        "coordinator": {
          "$ref": "#/$defs/CollaborationDecisionRoleIntent"
        },
        "executor": {
          "$ref": "#/$defs/CollaborationDecisionRoleIntent"
        }
      },
      "required": [
        "coordinator",
        "executor"
      ],
      "additionalProperties": false
    },
    "CollaborationDecisionIntent": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "provider": {
          "enum": [
            "inherit",
            "builtin",
            "jev"
          ]
        },
        "roles": {
          "$ref": "#/$defs/CollaborationDecisionRolesIntent"
        }
      },
      "required": [
        "version",
        "provider",
        "roles"
      ],
      "additionalProperties": false
    },
    "CollaborationStepUsage": {
      "type": "object",
      "description": "One entry per model step from committed usage rows; input excludes cache reads and writes. Null means unavailable, never zero. Pending has no recorded usage; partial contains recorded amounts only or lacks a price; settled requires a completed step and fully priced evidence. Decisions are accounted separately.",
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "plan",
            "execute",
            "clarify",
            "review",
            "repair",
            "verify",
            "handoff_repair"
          ]
        },
        "role": {
          "$ref": "#/$defs/CollaborationRole"
        },
        "state": {
          "enum": [
            "accepted",
            "starting",
            "running",
            "finalizing",
            "completed",
            "failed",
            "interrupted",
            "uncertain",
            "reviewed",
            "cancelled"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "settled",
            "partial",
            "unavailable"
          ]
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_read_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_write_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "total_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_micro_usd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "step_id",
        "run_id",
        "turn_id",
        "kind",
        "role",
        "state",
        "status",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "total_tokens",
        "cost_micro_usd",
        "models"
      ],
      "additionalProperties": false
    },
    "CollaborationWorkflow": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "direct",
            "reviewed"
          ]
        }
      },
      "required": [
        "version",
        "mode"
      ],
      "additionalProperties": false
    },
    "CollaborationCodeMapEntry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$)).+$"
        },
        "symbols": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 16
            },
            {
              "type": "null"
            }
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "constraints": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "maxItems": 8
            },
            {
              "type": "null"
            }
          ]
        },
        "excerpt": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "path",
        "purpose"
      ],
      "additionalProperties": false
    }
  }
}
