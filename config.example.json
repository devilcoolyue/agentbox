{
  "listen": "127.0.0.1:8180",
  "auth_token": "CHANGE_ME_TO_A_LONG_RANDOM_TOKEN",
  "data_dir": "data",
  "agent_image": "agentbox-agent:latest",
  "permission_mode": "bypassPermissions",
  "max_upload_mb": 512,
  "container": {
    "memory_mb": 2048,
    "cpus": 2,
    "pids_limit": 512,
    "network": "bridge"
  },
  "tunnel": {
    "enabled": false,
    "proxy_bind": "172.17.0.1:1080"
  },
  "pricing": {
    "codex": {
      "input": 5.0, "cache_read": 0.5, "cache_write": 0.0, "output": 30.0,
      "long_context_over": 272000,
      "long": { "input": 10.0, "cache_read": 1.0, "cache_write": 0.0, "output": 45.0 }
    },
    "gpt-5.4-mini": {
      "input": 0.75, "cache_read": 0.075, "cache_write": 0.0, "output": 4.5
    }
  },
  "accounts": [
    {
      "id": "claude-1",
      "type": "claude",
      "label": "Claude 订阅 #1",
      "credentials_dir": "accounts/claude-1"
    },
    {
      "id": "claude-apikey",
      "type": "claude",
      "label": "Claude API Key",
      "env": { "ANTHROPIC_API_KEY": "sk-ant-..." }
    },
    {
      "id": "codex-1",
      "type": "codex",
      "label": "Codex 订阅 #1",
      "credentials_dir": "accounts/codex-1"
    }
  ]
}
