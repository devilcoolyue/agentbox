{
  "listen": "127.0.0.1:8180",
  "auth_token": "CHANGE_ME_TO_A_LONG_RANDOM_TOKEN",
  "data_dir": "data",
  "cache_dir": "",
  "resources": {
    "max_running": 0,
    "max_running_per_user": 0,
    "min_free_bytes": 0
  },
  "agent_image": "agentbox-agent:latest",
  "image_updates": {
    "enabled": false,
    "channel": "stable",
    "time": "04:00",
    "update_codex": false
  },
  "permission_mode": "bypassPermissions",
  "max_upload_mb": 512,
  "timezone": "Asia/Shanghai",
  "container": {
    "memory_mb": 2048,
    "cpus": 2,
    "pids_limit": 512,
    "network": "bridge"
  },
  "tunnel": {
    "transparent": true,
    "network_bind": "172.17.0.1:1082",
    "network_image": "agentbox-network:latest",
    "enabled": false,
    "proxy_bind": "172.17.0.1:1080"
  },
  "proxy_bridge": {
    "bind": "172.17.0.1:1081"
  },
  "proxies": [
    {
      "id": "px-hk1",
      "name": "香港 #1",
      "scheme": "socks5",
      "host": "1.2.3.4",
      "port": 1080,
      "username": "proxy-user",
      "password": "proxy-pass"
    }
  ],
  "default_models": {
    "codex": "gpt-5.5",
    "claude": "claude-opus-5"
  },
  "pricing_catalog": {
    "url": "",
    "auto_check": false
  },
  "pricing": {
    "codex": {
      "input": 5.0, "cache_read": 0.5, "cache_write": 0.0, "output": 30.0,
      "long_context_over": 272000,
      "long": { "input": 10.0, "cache_read": 1.0, "cache_write": 0.0, "output": 45.0 }
    },
    "gpt-5.4-mini": {
      "input": 0.75, "cache_read": 0.075, "cache_write": 0.0, "output": 4.5
    }
  },
  "accounts": [
    {
      "id": "claude-1",
      "type": "claude",
      "label": "Claude 订阅 #1",
      "credentials_dir": "accounts/claude-1",
      "proxy_id": "px-hk1"
    },
    {
      "id": "claude-apikey",
      "type": "claude",
      "label": "Claude API Key",
      "env": { "ANTHROPIC_API_KEY": "sk-ant-..." }
    },
    {
      "id": "codex-1",
      "type": "codex",
      "label": "Codex 订阅 #1",
      "credentials_dir": "accounts/codex-1"
    }
  ]
}
